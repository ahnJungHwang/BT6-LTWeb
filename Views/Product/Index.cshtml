@model IEnumerable<BTVN6.Models.Product>
@{
    ViewData["Title"] = "Sản phẩm";
    var categories = ViewBag.Categories as IEnumerable<BTVN6.Models.Category>;
    var selectedId = ViewBag.SelectedCategoryId as int?;
}

<h1>@ViewData["Title"]</h1>

<div class="mb-4">
    <a asp-action="Index" class="btn @(selectedId == null ? "btn-primary" : "btn-outline-primary") me-2">Tất cả</a>
    @if (categories != null)
    {
        @foreach (var cat in categories)
        {
            <a asp-action="Index" asp-route-categoryId="@cat.Id"
               class="btn @(selectedId == cat.Id ? "btn-primary" : "btn-outline-primary") me-2">@cat.Name</a>
        }
    }
</div>

<div class="row">
@foreach (var item in Model)
{
    <div class="col-md-4 mb-4">
        <div class="card h-100">
            @if (!string.IsNullOrEmpty(item.ImageUrl))
            {
                <img src="@item.ImageUrl" class="card-img-top" alt="@item.Name" style="height:200px;object-fit:cover;" />
            }
            <div class="card-body">
                <h5 class="card-title">@item.Name</h5>
                <p class="card-text text-muted">@item.Category?.Name</p>
                <p class="card-text fw-bold">@item.Price.ToString("N0") đ</p>
                <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-outline-primary">Xem chi tiết</a>
            </div>
        </div>
    </div>
}
</div>

@if (!Model.Any())
{
    <p class="text-muted">Chưa có sản phẩm trong danh mục này.</p>
}
