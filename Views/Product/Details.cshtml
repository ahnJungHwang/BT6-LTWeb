@model BTVN6.Models.Product
@{
    ViewData["Title"] = Model.Name;
}

<h1>@Model.Name</h1>

<div class="row">
    <div class="col-md-5">
        @if (!string.IsNullOrEmpty(Model.ImageUrl))
        {
            <img src="@Model.ImageUrl" class="img-fluid rounded" alt="@Model.Name" />
        }
    </div>
    <div class="col-md-7">
        <dl class="row">
            <dt class="col-sm-3">Giá</dt>
            <dd class="col-sm-9 fs-4 text-danger">@Model.Price.ToString("N0") đ</dd>
            <dt class="col-sm-3">Danh mục</dt>
            <dd class="col-sm-9">@Model.Category?.Name</dd>
            <dt class="col-sm-3">Mô tả</dt>
            <dd class="col-sm-9">@Model.Description</dd>
        </dl>
        <a asp-action="Index" asp-route-categoryId="@Model.CategoryId" class="btn btn-secondary">Quay lại danh sách</a>
    </div>
</div>
