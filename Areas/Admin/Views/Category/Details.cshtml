@model BTVN6.Models.Category
@{
    ViewData["Title"] = "Chi tiết danh mục";
}

<h1>@ViewData["Title"]</h1>
<div>
    <dl class="row">
        <dt class="col-sm-2">Tên danh mục</dt>
        <dd class="col-sm-10">@Model.Name</dd>
        <dt class="col-sm-2">Số sản phẩm</dt>
        <dd class="col-sm-10">@Model.Products?.Count</dd>
    </dl>
</div>
<div>
    <a asp-action="Edit" asp-route-id="@Model.Id">Sửa</a> |
    <a asp-action="Index">Quay lại</a>
</div>
